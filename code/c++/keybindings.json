[
  {
    "key": "ctrl+enter",
    "command": "workbench.action.tasks.runTask",
    "args": "Run test cases (C++,linux)",
    "when": "resourceExtname == .cpp"
  },
  {
    "key": "ctrl+enter",
    "command": "workbench.action.tasks.runTask",
    "args": "Run test cases (python, linux)",
    "when": "resourceExtname == .py"
  }
]